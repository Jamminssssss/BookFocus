    "first thought when wake =\nseed for whole day. books\nplant one small good thought,\ngrow good day tree." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "first thought when wake =\nseed for whole day. books\nplant one small good thought,\ngrow good day tree."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "el primer pensamiento al despertar =\nla semilla de todo el día. los libros\nplantan un pequeño buen pensamiento,\ny hacen crecer el árbol de un buen día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "première pensée au réveil =\ngraine pour toute la journée. les livres\nplantent une petite bonne pensée,\npour faire grandir l'arbre d'une belle journée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pikiran pertama saat bangun =\nbenih untuk sepanjang hari. buku\nmenanam satu pikiran baik yang kecil,\nmenumbuhkan pohon hari yang indah."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目覚めた時の最初の思考 ＝\n１日の種。本は\n小さな良い思考を植え、\n素晴らしい１日の木を育てる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아침에 눈떠 처음 하는 생각 =\n하루를 결정짓는 씨앗. 책은\n작고 좋은 생각 하나를 심어,\n좋은 하루라는 나무를 키워냅니다."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความคิดแรกเมื่อตื่นนอน =\nเมล็ดพันธุ์ของทั้งวัน หนังสือ\nปลูกฝังความคิดดีๆ เล็กๆ\nเพื่อเติบโตเป็นต้นไม้แห่งวันที่สดใส"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "suy nghĩ đầu tiên khi thức dậy =\nhạt giống cho cả ngày. sách\ngieo một suy nghĩ tốt lành nhỏ bé,\nnuôi lớn cái cây của một ngày tuyệt vời."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "晨起的第一丝念头 =\n开启一整天的种子。书籍\n播下一颗美好和善的小种子，\n长成美妙幸福的一天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "晨起的第一絲念頭 =\n開啟一整天的種子。書籍\n播下一顆美好和善的小種子，\n長成美妙幸福的一天。"
          }
        }
      }
    },
