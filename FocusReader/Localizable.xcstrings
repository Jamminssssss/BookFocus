    "Get unlimited books, notes, and remove ads. Enjoy full reading stats!" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los libros ilimitado, notas y eliminar anuncios.¡Disfrute de la lectura completa!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtenez des livres illimités, des notes et supprimez les annonces. Profitez de la lecture complète des statistiques!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dapatkan buku tak terbatas, catatan, dan hapus iklan. Nikmati statistik pembacaan lengkap!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本やメモを無制限に入手し、広告を削除できます。 全巻読み放題をお楽しみいただけます！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무제한으로 책을 읽고, 메모를 하고, 광고를 삭제하세요. 통계를 모두 읽어보세요!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รับหนังสือ, โน้ต, และลบโฆษณาได้ไม่จำกัดจำนวน. ขอให้สนุกกับการอ่านสถิติ!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhận được không giới hạn sách, ghi chú và xóa quảng cáo. Đọc thống kê đầy đủ!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "获取无限量的书籍和笔记，并移除广告。 享受完整的阅读统计数据！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "獲取無限量的書籍和筆記，並移除廣告。 享受完整的閱讀統計數據！"
          }
        }
      }
    },
