    "The app started in recovery mode because your reading data could not be opened. Your existing data has not been deleted." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app started in recovery mode because your reading data could not be opened. Your existing data has not been deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La aplicación se ha iniciado en modo de recuperación porque no se pudieron abrir tus datos de lectura. Tus datos existentes no se han eliminado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’application a démarré en mode de récupération car vos données de lecture n’ont pas pu être ouvertes. Vos données existantes n’ont pas été supprimées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi dimulai dalam mode pemulihan karena data membaca Anda tidak dapat dibuka. Data Anda yang sudah ada tidak dihapus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読書データを開けなかったため、復旧モードで起動しました。既存のデータは削除されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기존 독서 데이터 저장소를 열지 못해 복구 모드로 실행했습니다. 기존 데이터는 삭제되지 않았습니다."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แอปเริ่มทำงานในโหมดกู้คืนเนื่องจากไม่สามารถเปิดข้อมูลการอ่านของคุณได้ ข้อมูลเดิมของคุณไม่ได้ถูกลบ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng đã khởi động ở chế độ khôi phục vì không thể mở dữ liệu đọc của bạn. Dữ liệu hiện có của bạn chưa bị xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法打开您的阅读数据，应用已在恢复模式下启动。您的现有数据未被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法開啟您的閱讀資料，應用程式已在復原模式下啟動。您的現有資料並未刪除。"
          }
        }
      }
    },
    "The app started in temporary mode because data storage could not be opened. Data added during this session will not be saved after the app closes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app started in temporary mode because data storage could not be opened. Data added during this session will not be saved after the app closes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La aplicación se ha iniciado en modo temporal porque no se pudo abrir el almacenamiento de datos. Los datos añadidos en esta sesión no se guardarán al cerrar la aplicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’application a démarré en mode temporaire car le stockage des données n’a pas pu être ouvert. Les données ajoutées pendant cette session ne seront pas conservées après la fermeture de l’application."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi dimulai dalam mode sementara karena penyimpanan data tidak dapat dibuka. Data yang ditambahkan selama sesi ini tidak akan disimpan setelah aplikasi ditutup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データストレージを開けなかったため、一時モードで起動しました。今回追加したデータは、アプリを閉じると保存されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터 저장소를 열지 못해 임시 모드로 실행했습니다. 이 실행에서 추가한 데이터는 앱 종료 후 저장되지 않습니다."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แอปเริ่มทำงานในโหมดชั่วคราวเนื่องจากไม่สามารถเปิดพื้นที่จัดเก็บข้อมูลได้ ข้อมูลที่เพิ่มในเซสชันนี้จะไม่ถูกบันทึกหลังจากปิดแอป"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng đã khởi động ở chế độ tạm thời vì không thể mở kho dữ liệu. Dữ liệu thêm trong phiên này sẽ không được lưu sau khi đóng ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法打开数据存储，应用已在临时模式下启动。本次使用期间添加的数据在关闭应用后不会保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法開啟資料儲存，應用程式已在暫時模式下啟動。本次使用期間新增的資料在關閉應用程式後不會儲存。"
          }
        }
      }
    },
    "The scanned book is a paper book. Cannot add in E-Book mode." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The scanned book is a paper book. Cannot add in E-Book mode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El libro escaneado es un libro impreso. No se puede añadir en el modo de libro electrónico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le livre numérisé est un livre papier. Impossible de l'ajouter en mode livre numérique."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buku yang dipindai adalah buku cetak. Tidak dapat ditambahkan dalam mode Buku Elektronik."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキャンした本は紙の本です。電子書籍モードでは追加できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스캔한 책은 종이책입니다. 전자책 모드에서는 추가할 수 없습니다."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หนังสือที่สแกนเป็นหนังสือกระดาษ ไม่สามารถเพิ่มในโหมดหนังสืออิเล็กทรอนิกส์ได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
